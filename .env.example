# Database connection string (PostgreSQL)
DATABASE_URL=

# JWT Secret for access tokens (min 32 chars)
JWT_SECRET=

# JWT Secret for refresh tokens (min 32 chars)
JWT_REFRESH_SECRET=

# Expiration time for access tokens (e.g., 15m)
JWT_EXPIRES_IN=

# Expiration time for refresh tokens (e.g., 7d)
JWT_REFRESH_EXPIRES_IN=

# Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=

# Nutritionix API Application ID
NUTRITIONIX_APP_ID=

# Nutritionix API Key
NUTRITIONIX_API_KEY=

# Google Gemini API Key
GEMINI_API_KEY=

# Cloudinary Connection URL
CLOUDINARY_URL=

# Port for the Express server to listen on
PORT=

# Node environment (development, production, test)
NODE_ENV=

# Vite API Base URL for the frontend
VITE_API_BASE_URL=

# Vite Google OAuth Client ID for the frontend
VITE_GOOGLE_CLIENT_ID=
